# Clé API SECRETE - ne jamais partager
.env

# Fichiers Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environnement virtuel
venv/
.venv/
env/

# Documents temporaires (garder le dossier via .gitkeep)
documents/*
!documents/.gitkeep

