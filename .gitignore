# Clé API SECRETE - ne jamais partager
.env

# Fichiers Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environnement virtuel
venv/
.venv/
env/

# Documents temporaires (garder le dossier via .gitkeep)
documents/*
!documents/.gitkeep

# Questionnaires de test regenerables (voir make_*.py)
documents_tests/*
!documents_tests/.gitkeep

# Captures d'ecran de test
captures/*
!captures/.gitkeep

# Construction de l'executable (ETAPE 15)
# (build/ et dist/ deja ignores ci-dessus)
*.exe

# Configuration locale de la machine (unique par poste)
config.json

# Rapports (garder le dossier)
reports/*
!reports/.gitkeep
client/reports/*
!client/reports/.gitkeep

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Dependencies
*.egg
*.whl
